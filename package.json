{
  "name": "@mansourfall/readit",
  "version": "0.2.0",
  "description": "Beyond the README: evidence-backed use cases and interactive UML flows for humans.",
  "keywords": [
    "developer-tools",
    "documentation",
    "uml",
    "codebase",
    "onboarding",
    "codex",
    "agent-skill"
  ],
  "author": "Mansour Fall",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MansourFall/readit.git"
  },
  "homepage": "https://github.com/MansourFall/readit#readme",
  "bugs": {
    "url": "https://github.com/MansourFall/readit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "readit": "bin/readit.js"
  },
  "files": [
    "bin",
    "src",
    "web",
    "skills",
    "examples",
    "README.md",
    "LICENSE",
    "schema",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "start": "node bin/readit.js demo",
    "demo": "node bin/readit.js demo",
    "test": "node --test test/*.test.js",
    "test:ui": "node test/browser.mjs",
    "build": "node bin/readit.js build examples/shop/readit.json --out dist/readit.html",
    "spec:validate": "openspec validate --all --strict",
    "skill:install": "node bin/readit.js install-skill"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.1",
    "playwright": "1.62.1"
  }
}
