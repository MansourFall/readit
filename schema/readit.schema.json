{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "READIT model 1.0",
  "description": "Structural schema. CLI validation additionally checks IDs, references, safe paths, and line ranges.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "name",
        "description"
      ]
    },
    "analysis": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "demo",
            "agent",
            "manual"
          ]
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "maxItems": 200,
          "minItems": 0
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      },
      "required": [
        "mode",
        "generatedAt",
        "scope",
        "limitations"
      ]
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "maxItems": 40,
      "minItems": 0
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "kind": {
            "enum": [
              "actor",
              "component",
              "database",
              "external"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ]
      },
      "maxItems": 40,
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "startLine": {
            "type": "integer",
            "minimum": 1
          },
          "endLine": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "snippet": {
            "type": "string",
            "maxLength": 30000
          }
        },
        "required": [
          "id",
          "path",
          "startLine",
          "endLine",
          "sha256",
          "reason"
        ]
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "useCases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "actorIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w-]{0,63}$"
            },
            "maxItems": 1000,
            "minItems": 1
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "maxItems": 200,
            "minItems": 0
          },
          "postconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "maxItems": 200,
            "minItems": 0
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][\\w-]{0,63}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "outcome": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-zA-Z][\\w-]{0,63}$"
                      },
                      "from": {
                        "type": "string",
                        "pattern": "^[a-zA-Z][\\w-]{0,63}$"
                      },
                      "to": {
                        "type": "string",
                        "pattern": "^[a-zA-Z][\\w-]{0,63}$"
                      },
                      "kind": {
                        "enum": [
                          "call",
                          "return",
                          "async"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "confidence": {
                        "enum": [
                          "observed",
                          "inferred"
                        ]
                      },
                      "evidenceIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-zA-Z][\\w-]{0,63}$"
                        },
                        "maxItems": 1000,
                        "minItems": 0
                      },
                      "rationale": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "id",
                      "from",
                      "to",
                      "kind",
                      "label",
                      "description",
                      "confidence",
                      "evidenceIds"
                    ],
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "confidence": {
                              "const": "inferred"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "rationale"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "confidence": {
                              "const": "observed"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "evidenceIds": {
                              "minItems": 1
                            }
                          }
                        }
                      }
                    ]
                  },
                  "maxItems": 100,
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "name",
                "outcome",
                "steps"
              ]
            },
            "maxItems": 20,
            "minItems": 1
          },
          "confidence": {
            "enum": [
              "observed",
              "inferred"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w-]{0,63}$"
            },
            "maxItems": 1000,
            "minItems": 0
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "name",
          "goal",
          "actorIds",
          "preconditions",
          "postconditions",
          "scenarios",
          "confidence",
          "evidenceIds"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "confidence": {
                  "const": "inferred"
                }
              }
            },
            "then": {
              "required": [
                "rationale"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "confidence": {
                  "const": "observed"
                }
              }
            },
            "then": {
              "properties": {
                "evidenceIds": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "maxItems": 100,
      "minItems": 0
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w-]{0,63}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w-]{0,63}$"
          },
          "kind": {
            "enum": [
              "include",
              "extend"
            ]
          },
          "confidence": {
            "enum": [
              "observed",
              "inferred"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][\\w-]{0,63}$"
            },
            "maxItems": 1000,
            "minItems": 0
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "from",
          "to",
          "kind",
          "confidence",
          "evidenceIds"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "confidence": {
                  "const": "inferred"
                }
              }
            },
            "then": {
              "required": [
                "rationale"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "confidence": {
                  "const": "observed"
                }
              }
            },
            "then": {
              "properties": {
                "evidenceIds": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "maxItems": 200,
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "analysis",
    "actors",
    "participants",
    "evidence",
    "useCases",
    "relationships"
  ]
}
